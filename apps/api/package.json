    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@types/node": "^26.6.3",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
