{
  "openapi": "3.1.0",
  "info": {
    "title": "doodle API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "FileList": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileItem"
            }
          }
        },
        "required": [
          "files"
        ]
      },
      "FileItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DesignSystemItem"
          },
          {
            "$ref": "#/components/schemas/AppItem"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "designSystem": "#/components/schemas/DesignSystemItem",
            "app": "#/components/schemas/AppItem"
          }
        }
      },
      "DesignSystemItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "designSystem"
            ]
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "latestRelease": {
            "$ref": "#/components/schemas/ReleaseSummary"
          },
          "usedByApps": {
            "type": "integer"
          },
          "referenced": {
            "type": "boolean"
          },
          "hasUnreleasedChanges": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "updatedAt",
          "latestRelease",
          "usedByApps",
          "referenced",
          "hasUnreleasedChanges"
        ]
      },
      "ReleaseSummary": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "createdAt",
          "message"
        ]
      },
      "AppItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "app"
            ]
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "reference": {
            "$ref": "#/components/schemas/ReleaseReference"
          },
          "hasNewerRelease": {
            "type": "boolean"
          },
          "inProgressRequests": {
            "type": "integer"
          },
          "pageCount": {
            "type": "integer"
          },
          "thumbnailDocument": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "updatedAt",
          "reference",
          "hasNewerRelease",
          "inProgressRequests",
          "pageCount",
          "thumbnailDocument"
        ]
      },
      "ReleaseReference": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "designSystem": {
            "type": "string"
          },
          "release": {
            "type": "string"
          }
        },
        "required": [
          "designSystem",
          "release"
        ]
      },
      "DocumentEntry": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "skeleton"
                ]
              },
              "page": {
                "type": "string"
              },
              "release": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "file",
              "kind",
              "page",
              "release"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "proposal"
                ]
              },
              "page": {
                "type": "string"
              },
              "request": {
                "type": "string"
              },
              "release": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "file",
              "kind",
              "page",
              "request",
              "release"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "snapshot"
                ]
              },
              "page": {
                "type": "string"
              },
              "request": {
                "type": "string"
              },
              "release": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "file",
              "kind",
              "page",
              "request",
              "release"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "dsDraft"
                ]
              },
              "release": {
                "type": "null"
              }
            },
            "required": [
              "id",
              "file",
              "kind",
              "release"
            ]
          }
        ]
      },
      "CatalogError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ThumbnailPut": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "revision": {
                "type": "integer"
              },
              "contentType": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "revision",
              "contentType",
              "image"
            ]
          },
          {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              },
              "revision": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "revision",
              "reason"
            ]
          }
        ]
      },
      "Thumbnail": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "revision": {
                "type": "integer"
              },
              "contentType": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "revision",
              "contentType",
              "image"
            ]
          },
          {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              },
              "revision": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "revision",
              "reason"
            ]
          },
          {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "none"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        ]
      },
      "RequestList": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          }
        },
        "required": [
          "requests"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedback": {
            "type": "string"
          },
          "previous": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/RequestState"
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "delivered": {
            "type": "boolean"
          },
          "adoptedProposal": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "page",
          "snapshot",
          "references",
          "feedback",
          "previous",
          "state",
          "agent",
          "delivered",
          "adoptedProposal"
        ]
      },
      "RequestState": {
        "type": "string",
        "enum": [
          "requested",
          "inProgress",
          "awaitingChoice",
          "completed",
          "aborted"
        ]
      },
      "TransitionError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RequestState"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "AbortedRequests": {
        "type": "object",
        "properties": {
          "aborted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "aborted"
        ]
      },
      "Page": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "skeleton": {
            "type": "string"
          },
          "adoptedProposal": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "file",
          "name",
          "skeleton",
          "adoptedProposal"
        ]
      },
      "Thread": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "awaitingReply": {
            "type": "boolean"
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          }
        },
        "required": [
          "id",
          "document",
          "node",
          "awaitingReply",
          "comments"
        ]
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "authorKind": {
            "$ref": "#/components/schemas/AuthorKind"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "authorKind",
          "body",
          "createdAt"
        ]
      },
      "AuthorKind": {
        "type": "string",
        "enum": [
          "human",
          "agent"
        ]
      },
      "AddThread": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "authorKind": {
            "$ref": "#/components/schemas/AuthorKind"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "document",
          "node",
          "authorKind",
          "body"
        ]
      },
      "AddComment": {
        "type": "object",
        "properties": {
          "authorKind": {
            "$ref": "#/components/schemas/AuthorKind"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "authorKind",
          "body"
        ]
      },
      "ThreadList": {
        "type": "object",
        "properties": {
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Thread"
            }
          }
        },
        "required": [
          "threads"
        ]
      },
      "PageList": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          }
        },
        "required": [
          "pages"
        ]
      },
      "CreatedFile": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          },
          "draftDocumentId": {
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ]
      },
      "CreateNameError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_name"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreationError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "registration_failed",
              "initialization_failed"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateFileBody": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "designSystem"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "description": "The name must be 1 to 50 characters and not only whitespace. Length is counted in Unicode code points."
              }
            },
            "required": [
              "kind",
              "name"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "app"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "description": "The name must be 1 to 50 characters and not only whitespace. Length is counted in Unicode code points."
              },
              "reference": {
                "$ref": "#/components/schemas/ReleaseReference"
              }
            },
            "required": [
              "kind",
              "name",
              "reference"
            ]
          }
        ]
      },
      "CreatedPage": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string"
          },
          "skeletonDocumentId": {
            "type": "string"
          }
        },
        "required": [
          "pageId",
          "skeletonDocumentId"
        ]
      },
      "CreatePageBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "The name must be 1 to 50 characters and not only whitespace. Length is counted in Unicode code points."
          }
        },
        "required": [
          "name"
        ]
      },
      "CreatedCandidate": {
        "type": "object",
        "properties": {
          "candidateDocumentId": {
            "type": "string"
          }
        },
        "required": [
          "candidateDocumentId"
        ]
      },
      "CandidateRefusal": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "request_aborted",
              "taken_by_another_agent",
              "request_finished",
              "request_not_taken"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateCandidateBody": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          }
        },
        "required": [
          "agentId"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "API が動いています。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "operationId": "listFiles",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "ファイルの一覧です。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createFile",
        "tags": [
          "files"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFileBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作ったファイルです。DS のファイルには空の下書きの文書も作ります。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedFile"
                }
              }
            }
          },
          "400": {
            "description": "名前が決まりに合いません。何も作りません。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateNameError"
                }
              }
            }
          },
          "500": {
            "description": "文書の初期化か登録に失敗しました。何も残りません。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/recent": {
      "get": {
        "operationId": "listRecentFiles",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "更新日時の新しい順の最近のファイルです。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}": {
      "get": {
        "operationId": "getDocument",
        "tags": [
          "catalog"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "登録簿の文書です。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentEntry"
                }
              }
            }
          },
          "404": {
            "description": "登録されていない文書 ID です。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{documentId}/summary": {
      "put": {
        "operationId": "putDocumentSummary",
        "tags": [
          "catalog"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "documentId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "number"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "revision",
                  "updatedAt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "書き込みのあとに残っている概要です。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "number"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "revision",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getDocumentSummary",
        "tags": [
          "catalog"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "documentId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "文書の概要です。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "number"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "revision",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "概要がまだ届いていない文書です。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{documentId}/thumbnail": {
      "put": {
        "operationId": "putDocumentThumbnail",
        "tags": [
          "catalog"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "documentId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThumbnailPut"
              }
            }
          }
        },
        "responses": {
          "204": {
